{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Consumer",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/consumer/main.go",
            "args": [
                "-config", "${workspaceFolder}/backend/configs/config.yaml",
                "-env", "${workspaceFolder}/backend/.env",
                "realtime:personal-delivery"
            ],
            "env": {
                "APP_ENV": "local"
            }
        },
        {
            "name": "Launch Outbox Relay",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/outbox_relay/main.go",
            "args": [
                "-config", "${workspaceFolder}/backend/configs/config.yaml",
                "-env", "${workspaceFolder}/backend/.env"
            ],
            "env": {
                "APP_ENV": "local"
            }
        },
        {
            "name": "Launch API",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/backend/cmd/api/main.go",
            "args": [
                "-config", "${workspaceFolder}/backend/configs/config.yaml",
                "-env", "${workspaceFolder}/backend/.env"
            ],
            "env": {
                "APP_ENV": "local"
            }
        }
    ]
}